<odoo>

    <!-- The screen that waits for a file.
         The same client action the viewer is, opened without a document: it
         shows the drop area, and once a file is chosen it becomes the viewer in
         place. One screen for the whole job, which is how the module this is a
         port of opens. -->
    <record id="action_easyocr_new_document" model="ir.actions.client">
        <field name="name">Upload a Document</field>
        <field name="tag">easyocr.document_viewer</field>
        <field name="target">fullscreen</field>
    </record>

</odoo>
