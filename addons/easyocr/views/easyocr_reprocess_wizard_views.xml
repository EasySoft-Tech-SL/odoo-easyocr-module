     The question asked before paying for a reading that has already been paid
     for. It is a dialog and not an error on purpose: the reader may know
     something the fingerprint does not, and the two answers are here. -->
<odoo>

    <record id="view_easyocr_reprocess_wizard_form" model="ir.ui.view">
        <field name="name">easyocr.reprocess.wizard.form</field>
        <field name="model">easyocr.reprocess.wizard</field>
        <field name="arch" type="xml">
            <form string="Read it again">
                <field name="document_id" invisible="1"/>
                <field name="duplicate_id" invisible="1"/>
                <field name="message" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_read_again" type="object"
                            string="Read it again" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Leave it"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_easyocr_reprocess_wizard" model="ir.actions.act_window">
        <field name="name">Read it again</field>
        <field name="res_model">easyocr.reprocess.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
