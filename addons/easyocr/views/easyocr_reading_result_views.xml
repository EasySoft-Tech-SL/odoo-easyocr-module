     What a reading found, on one screen. The document keeps what becomes an
     entry; this shows all of it, including the vendor's address and phone,
     which have nowhere else to be seen and used to be read and dropped. -->
<odoo>

    <record id="view_easyocr_reading_result_form" model="ir.ui.view">
        <field name="name">easyocr.reading.result.form</field>
        <field name="model">easyocr.reading.result</field>
        <field name="arch" type="xml">
            <form string="What the reading found">
                <field name="document_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="meta" nolabel="1" readonly="1"/>
                <group>
                    <group string="Vendor">
                        <field name="partner_name"/>
                        <field name="partner_vat"/>
                    </group>
                    <group string="Document">
                        <field name="ref"/>
                        <field name="document_date"/>
                        <field name="due_date"/>
                        <field name="is_refund"/>
                    </group>
                </group>
                <group>
                    <group>
                        <field name="amount_untaxed"/>
                        <field name="amount_total"/>
                    </group>
                    <group>
                        <field name="line_count"/>
                    </group>
                </group>
                <group>
                    <field name="extras" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_open_document" type="object"
                            string="Open the document" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_easyocr_reading_result" model="ir.actions.act_window">
        <field name="name">What the reading found</field>
        <field name="res_model">easyocr.reading.result</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
