<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- The reading result: a sectioned modal over the screen, the way the
         module this is a port of shows it. One collapsible card per part of the
         answer, the raw payload behind the JSON button, and the two buttons that
         either leave it or turn it into the bill. -->
    <t t-name="easyocr.OCRResultDialog">
        <div class="o_easyocr_result_overlay" t-on-click="close">
            <div class="o_easyocr_result_modal" t-on-click.stop="() => {}">

                <div class="o_easyocr_result_header">
                    <div class="o_easyocr_result_title">
                        <i class="fa fa-magic me-2"/>
                        <h4>AI Result</h4>
                        <div class="o_easyocr_result_pills">
                            <t t-foreach="pills()" t-as="pill" t-key="pill_index">
                                <span class="o_easyocr_result_pill"><t t-esc="pill"/></span>
                            </t>
                        </div>
                    </div>
                    <div class="o_easyocr_result_head_actions">
                        <button
                            class="btn btn-link btn-sm"
                            t-on-click="togglePayload"
                            t-att-class="state.showPayload ? 'btn btn-link btn-sm active' : 'btn btn-link btn-sm'"
                        >
                            <i class="fa fa-code me-1"/>JSON
                        </button>
                        <button class="btn btn-link btn-sm" t-on-click="close"><i class="fa fa-times"/></button>
                    </div>
                </div>

                <div t-if="state.showPayload" class="o_easyocr_result_payload">
                    <pre><t t-esc="payloadText()"/></pre>
                </div>

                <div class="o_easyocr_result_body">
                    <div t-if="hasSection('document')" class="o_easyocr_result_card">
                        <div class="o_easyocr_result_card_head" t-on-click="() => this.toggleCard('document')">
                            <i class="fa fa-file-o me-1"/>
                            <span>Document</span>
                            <i class="fa fa-chevron-down ms-auto"/>
                        </div>
                        <div t-if="!isCollapsed('document')" class="o_easyocr_result_card_body">
                            <div t-foreach="sectionRows('document')" t-as="row" t-key="row_index" class="o_easyocr_result_row">
                                <span class="o_easyocr_result_label"><t t-esc="row[0]"/></span>
                                <span class="o_easyocr_result_value"><t t-esc="row[1]"/></span>
                            </div>
                        </div>
                    </div>

                    <div t-if="hasSection('supplier')" class="o_easyocr_result_card">
                        <div class="o_easyocr_result_card_head" t-on-click="() => this.toggleCard('supplier')">
                            <i class="fa fa-home me-1"/>
                            <span>Supplier</span>
                            <i class="fa fa-chevron-down ms-auto"/>
                        </div>
                        <div t-if="!isCollapsed('supplier')" class="o_easyocr_result_card_body">
                            <div t-foreach="sectionRows('supplier')" t-as="row" t-key="row_index" class="o_easyocr_result_row">
                                <span class="o_easyocr_result_label"><t t-esc="row[0]"/></span>
                                <span class="o_easyocr_result_value"><t t-esc="row[1]"/></span>
                            </div>
                        </div>
                    </div>

                    <div t-if="hasSection('customer')" class="o_easyocr_result_card">
                        <div class="o_easyocr_result_card_head" t-on-click="() => this.toggleCard('customer')">
                            <i class="fa fa-user-o me-1"/>
                            <span>Customer</span>
                            <i class="fa fa-chevron-down ms-auto"/>
                        </div>
                        <div t-if="!isCollapsed('customer')" class="o_easyocr_result_card_body">
                            <div t-foreach="sectionRows('customer')" t-as="row" t-key="row_index" class="o_easyocr_result_row">
                                <span class="o_easyocr_result_label"><t t-esc="row[0]"/></span>
                                <span class="o_easyocr_result_value"><t t-esc="row[1]"/></span>
                            </div>
                        </div>
                    </div>

                    <div t-if="hasSection('lines')" class="o_easyocr_result_card">
                        <div class="o_easyocr_result_card_head" t-on-click="() => this.toggleCard('lines')">
                            <i class="fa fa-list-ul me-1"/>
                            <span>Invoice lines</span>
                            <span class="o_easyocr_result_count"><t t-esc="items().length"/></span>
                            <i class="fa fa-chevron-down ms-auto"/>
                        </div>
                        <div t-if="!isCollapsed('lines')" class="o_easyocr_result_card_body o_easyocr_result_lines">
                            <table class="o_easyocr_result_table">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Description</th>
                                        <th class="text-end">Qty</th>
                                        <th class="text-end">Price</th>
                                        <th class="text-end">Disc%</th>
                                        <th class="text-end">Tax%</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.items" t-as="item" t-key="item_index">
                                        <tr>
                                            <td><t t-esc="item.code"/></td>
                                            <td><input class="o_easyocr_result_input" t-model="item.description"/></td>
                                            <td class="text-end"><input class="o_easyocr_result_input o_easyocr_result_input_number" type="number" step="any" t-model="item.quantity"/></td>
                                            <td class="text-end"><input class="o_easyocr_result_input o_easyocr_result_input_number" type="number" step="any" t-model="item.unit_price"/></td>
                                            <td class="text-end"><input class="o_easyocr_result_input o_easyocr_result_input_number" type="number" step="any" t-model="item.discount_percent"/></td>
                                            <td class="text-end"><t t-esc="item.tax_rate"/></td>
                                            <td class="text-end">
                                                <button class="btn btn-link btn-sm o_easyocr_result_remove" type="button" t-on-click="() => this.removeLine(item_index)">
                                                    <i class="fa fa-times"/>
                                                </button>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <button class="btn btn-link btn-sm o_easyocr_result_add_line" type="button" t-on-click="addLine">
                                <i class="fa fa-plus me-1"/>Add line
                            </button>
                        </div>
                    </div>

                    <div t-if="hasSection('totals')" class="o_easyocr_result_card">
                        <div class="o_easyocr_result_card_head" t-on-click="() => this.toggleCard('totals')">
                            <i class="fa fa-eur me-1"/>
                            <span>Totals</span>
                            <i class="fa fa-chevron-down ms-auto"/>
                        </div>
                        <div t-if="!isCollapsed('totals')" class="o_easyocr_result_card_body">
                            <div t-foreach="sectionRows('totals')" t-as="row" t-key="row_index" class="o_easyocr_result_row">
                                <span class="o_easyocr_result_label"><t t-esc="row[0]"/></span>
                                <span class="o_easyocr_result_value"><t t-esc="row[1]"/></span>
                            </div>
                        </div>
                    </div>

                    <div t-if="hasSection('payment')" class="o_easyocr_result_card">
                        <div class="o_easyocr_result_card_head" t-on-click="() => this.toggleCard('payment')">
                            <i class="fa fa-credit-card me-1"/>
                            <span>Payment</span>
                            <i class="fa fa-chevron-down ms-auto"/>
                        </div>
                        <div t-if="!isCollapsed('payment')" class="o_easyocr_result_card_body">
                            <div t-foreach="sectionRows('payment')" t-as="row" t-key="row_index" class="o_easyocr_result_row">
                                <span class="o_easyocr_result_label"><t t-esc="row[0]"/></span>
                                <span class="o_easyocr_result_value"><t t-esc="row[1]"/></span>
                            </div>
                        </div>
                    </div>

                    <div t-if="hasSection('notes')" class="o_easyocr_result_card">
                        <div class="o_easyocr_result_card_head" t-on-click="() => this.toggleCard('notes')">
                            <i class="fa fa-pencil me-1"/>
                            <span>Notes</span>
                            <i class="fa fa-chevron-down ms-auto"/>
                        </div>
                        <div t-if="!isCollapsed('notes')" class="o_easyocr_result_card_body">
                            <t t-esc="notes()"/>
                        </div>
                    </div>
                </div>

                <div class="o_easyocr_result_footer">
                    <div class="o_easyocr_result_status me-auto">
                        <span class="o_easyocr_result_status_label">Status</span>
                        <label class="form-check form-check-inline">
                            <input type="radio" class="form-check-input" name="ocr_status" t-att-checked="!state.draft" t-on-click="() => this.state.draft = false"/>
                            <span>Validated</span>
                        </label>
                        <label class="form-check form-check-inline">
                            <input type="radio" class="form-check-input" name="ocr_status" t-att-checked="state.draft" t-on-click="() => this.state.draft = true"/>
                            <span>Draft</span>
                        </label>
                        <span class="o_easyocr_result_status_label ms-3">Journal</span>
                        <select class="form-select form-select-sm" t-model="state.journalId">
                            <option value="">-- Automatic --</option>
                            <t t-foreach="state.journals" t-as="journal" t-key="journal.id">
                                <option t-att-value="journal.id"><t t-esc="journal.name"/></option>
                            </t>
                        </select>
                    </div>
                    <button class="btn btn-secondary" t-on-click="close">Cancel</button>
                    <button
                        class="btn btn-success"
                        t-on-click="createInvoice"
                        t-att-disabled="state.busy"
                    >
                        <i class="fa fa-check me-1"/>Create invoice
                    </button>
                    <div class="o_easyocr_result_payment">
                        <label class="form-check form-check-inline">
                            <input type="checkbox" class="form-check-input" t-model="state.createPayment"/>
                            <span>Create payment linked to the invoice</span>
                        </label>
                        <t t-if="state.createPayment">
                            <span class="o_easyocr_result_status_label ms-3">Payment method</span>
                            <select class="form-select form-select-sm" t-model="state.paymentModeId">
                                <option value="">-- Automatic --</option>
                                <t t-foreach="state.paymentModes" t-as="mode" t-key="mode.id">
                                    <option t-att-value="mode.id"><t t-esc="mode.name"/></option>
                                </t>
                            </select>
                            <span class="o_easyocr_result_status_label ms-3">Bank account</span>
                            <select class="form-select form-select-sm" t-model="state.bankId">
                                <option value="">-- Automatic --</option>
                                <t t-foreach="state.banks" t-as="bank" t-key="bank.id">
                                    <option t-att-value="bank.id"><t t-esc="bank.name"/></option>
                                </t>
                            </select>
                        </t>
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>
