     Odoo 19 dropped res.groups.category_id in favour of res.groups.privilege.
     The branch 18.0 of this repository keeps the older syntax; see the
     security file there. -->
<odoo>

    <record id="module_category_easyocr" model="ir.module.category">
        <field name="name">EasyOCR</field>
        <field name="description">Read supplier invoices and expense receipts from files.</field>
        <field name="sequence">90</field>
    </record>

    <record id="privilege_easyocr" model="res.groups.privilege">
        <field name="name">EasyOCR</field>
        <field name="category_id" ref="module_category_easyocr"/>
        <field name="sequence">90</field>
    </record>

    <record id="group_easyocr_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_easyocr"/>
        <field name="comment">Upload documents and review what was read from them.</field>
    </record>

    <record id="group_easyocr_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_easyocr"/>
        <field name="comment">Also delete documents and change the extraction settings.</field>
        <field name="implied_ids" eval="[(4, ref('group_easyocr_user'))]"/>
        <!-- Odoo 19 renamed res.groups.users to user_ids; branch 18.0 uses the old name. -->
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
