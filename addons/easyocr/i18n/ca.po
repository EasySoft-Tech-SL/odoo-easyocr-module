#. odoo-javascript
#: code:addons/easyocr/static/src/xml/easyocr_admin.xml:0
msgid "Legitimate interest"
msgstr "Interès legítim"

#. module: easyocr
#. odoo-javascript
#: code:addons/easyocr/static/src/xml/easyocr_admin.xml:0
msgid ""
"Providing an accurate and secure data extraction service, protecting system "
