msgstr "La facture n'a pas pu être créée (%(error)s)."

#. module: easyocr
#. odoo-python
#: code:addons/easyocr/models/easyocr_document.py:0
msgid "The bill was created from it."
msgstr "La facture a été créée à partir de celui-ci."

#. module: easyocr
#. odoo-python
#: code:addons/easyocr/models/easyocr_document.py:0
msgid "The bill was created, but the payment was not registered (%(reason)s)."
msgstr ""
"La facture a été créée, mais le paiement n'a pas été enregistré "
"(%(reason)s)."

#. module: easyocr
#. odoo-python
#: code:addons/easyocr/models/easyocr_document.py:0
msgid "The bill was created from it and the payment registered."
msgstr ""
"La facture a été créée à partir de celui-ci et le paiement enregistré."

#. module: easyocr
#. odoo-python
#: code:addons/easyocr/models/easyocr_document.py:0
msgid "no bank account is set in the EasyOCR settings"
msgstr "aucun compte bancaire n'est renseigné dans les réglages d'EasyOCR"

#. module: easyocr
#. odoo-python
#: code:addons/easyocr/models/easyocr_document.py:0
msgid "the bill is not confirmed, so there is nothing to pay yet"
msgstr "la facture n'est pas confirmée, il n'y a donc encore rien à payer"

#. module: easyocr
#. odoo-python
#: code:addons/easyocr/models/easyocr_document.py:0
msgid "the bill has nothing left to pay"
msgstr "il ne reste rien à payer sur la facture"
