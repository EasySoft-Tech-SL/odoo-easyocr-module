msgstr "Uno scontrino fotografato finisce come"

#. module: easyocr
#: model:ir.model.fields,field_description:easyocr.field_res_company__easyocr_expense_allow_validate
#: model:ir.model.fields,field_description:easyocr.field_res_config_settings__easyocr_expense_allow_validate
#: model_terms:ir.ui.view,arch_db:easyocr.res_config_settings_view_form_easyocr
