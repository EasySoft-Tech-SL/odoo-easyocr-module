<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="easyocr.DocumentViewer">
        <div class="o_easyocr_viewer">
            <div class="o_easyocr_viewer_body">
                <div t-if="this.state.empty" class="o_easyocr_viewer_pdf">
                    <!-- The screen waiting for a file: click or drop, the way
                         the module this is a port of opens. -->
                    <div
                        t-attf-class="o_easyocr_empty {{ this.state.dragging ? 'dragging' : '' }}"
                        t-on-click="() => this.fileInputRef().click()"
                        t-on-dragover="this.onDragOver"
                        t-on-dragleave="this.onDragLeave"
                        t-on-drop="this.onDrop"
                    >
                        <i class="oi" data-icon="picture_as_pdf"/>
                        <p class="o_easyocr_empty_title">Open a PDF, or drop one here</p>
                        <p class="o_easyocr_empty_hint">A PDF or a photo of an invoice or a receipt.</p>
                        <button class="btn btn-primary" type="button">
                            Choose a file
                        </button>
                        <input
                            t-ref="this.fileInputRef"
                            type="file"
                            class="d-none"
                            accept=".pdf,.jpg,.jpeg,.png"
                            t-on-change="this.onFileChosen"
                        />
                    </div>
                </div>
                <div t-else="" class="o_easyocr_viewer_pdf" t-ref="this.containerRef">
                    <div t-if="this.state.loading" class="o_easyocr_viewer_message">
                        <i class="oi oi-spin me-2" data-icon="progress_activity"/><t>Loading the document...</t>
                    </div>
                    <div t-if="this.state.error" class="o_easyocr_viewer_message text-danger">
                        <i class="oi me-2" data-icon="warning"/><t>This document has no file attached, or the file could not be read.</t>
                    </div>
                </div>

                <!-- The controls, in a column on the right, the way the module
                     this is a port of lays them out: the AI banner on top, then
                     the fields, the template, what was read, and a fixed footer
                     with the two actions that finish the job. -->
                <div class="o_easyocr_sidebar">
                    <div class="o_easyocr_sidebar_head">
                        <h4 t-out="this.state.documentName"/>
                        <p class="text-muted" t-if="this.state.pages.length" t-out="this.pagesLabel()"/>
                        <button
                            t-if="!this.state.empty"
                            class="btn btn-link btn-sm px-0"
                            t-on-click="this.backToDocument"
                        >
                            <i class="oi me-1" data-icon="arrow_back"/>Back to the document
                        </button>
                    </div>

                    <!-- The AI block stays put above the column, as in the module
                         this is a port of: only the middle scrolls, between it
                         and the footer with the actions and the help. -->
                    <div class="o_easyocr_sidebar_fixed" t-if="this.state.account">
                    <!-- The AI banner. Always on top, two states: configured
                         (the button, the block banner and the quota), and
                         not configured (a short note pointing at the
                         settings). It is the first thing the reader sees,
                         which is where the plan and what is left belong. -->
                    <div class="o_easyocr_section o_easyocr_ai_hero" t-if="this.state.account and this.state.account.ai_enabled">
                        <div class="o_easyocr_ai_hero_head">
                            <div class="o_easyocr_ai_hero_icon">
                                <i class="oi" data-icon="wand_stars"/>
                            </div>
                            <div>
                                <span class="o_easyocr_ai_hero_title">
                                    easyOCR AI
                                    <span class="o_easyocr_badge">PRO</span>
                                </span>
                                <p class="o_easyocr_ai_hero_hint">
                                    Send the PDF to AI service for automatic data extraction
                                </p>
                            </div>
                        </div>

                        <!-- Reading, with its bar. -->
                        <div t-if="this.state.busy" class="o_easyocr_busy">
                            <div t-if="this.state.busyPercent" class="o_easyocr_progress">
                                <div
                                    class="o_easyocr_progress_fill"
                                    t-attf-style="width: {{ this.state.busyPercent }}%"
                                />
                            </div>
                            <p class="text-muted mb-0">
                                <i class="oi oi-spin me-1" data-icon="progress_activity"/>
                                <t t-out="this.state.busyLabel"/>
                            </p>
                        </div>

                        <button
                            t-if="this.state.canReadWithAI"
                            class="o_easyocr_btn_ai w-100"
                            t-on-click="this.readWithAI"
                            t-att-disabled="this.state.busy"
                        >
                            <i class="oi me-1" data-icon="wand_stars"/>
                            Extract with AI
                        </button>

                        <div t-if="this.state.account.blocked" class="o_easyocr_blocked">
                            <i class="oi me-1" data-icon="warning"/>
                            <t t-out="this.state.account.message"/>
                        </div>

                        <!-- The plan and what is left, out of the same answer,
                             folded to one line until the reader opens it. -->
                        <div t-if="this.state.account.plan.name" class="o_easyocr_quota">
                            <button class="o_easyocr_quota_toggle" type="button" t-on-click="this.toggleQuota">
                                <span class="o_easyocr_quota_toggle_left">
                                    <span
                                        t-att-class="this.state.account.blocked ? 'o_easyocr_quota_status o_easyocr_quota_status_blocked' : 'o_easyocr_quota_status'"
                                        t-out="this.state.account.blocked ? '⚠️' : '✓'"
                                    />
                                    <span class="o_easyocr_quota_plan_name"><t t-out="this.state.account.plan.name"/></span>
                                    <span class="o_easyocr_quota_compact">
                                        <t t-out="this.state.account.quota.pages_used"/> / <t t-out="this.state.account.quota.pages_limit"/> Pages
                                    </span>
                                </span>
                                <span class="o_easyocr_quota_toggle_right">
                                    <span class="o_easyocr_quota_remaining"><t t-out="this.state.account.quota.pages_remaining"/> Left</span>
                                    <i class="oi" data-icon="expand_more"/>
                                </span>
                            </button>

                            <div t-if="this.state.quotaExpanded" class="o_easyocr_quota_details">
                                <div class="o_easyocr_quota_head">
                                    <span class="o_easyocr_quota_plan">
                                        <i class="oi me-1" data-icon="star"/>
                                        <t t-out="this.state.account.plan.name"/>
                                        <t t-if="this.state.account.plan.is_free">
                                            <span class="o_easyocr_badge o_easyocr_badge_free">FREE</span>
                                        </t>
                                    </span>
                                </div>
                                <div t-if="this.state.account.quota.pages_used !== undefined" class="o_easyocr_quota_bar">
                                    <div
                                        class="o_easyocr_quota_fill"
                                        t-attf-style="width: {{ this.quotaPercent() }}%"
                                    />
                                </div>
                                <div class="o_easyocr_quota_stats">
                                    <div class="o_easyocr_quota_stat">
                                        <span class="o_easyocr_quota_label">Pages</span>
                                        <span class="o_easyocr_quota_value">
                                            <t t-out="this.state.account.quota.pages_used"/> / <t t-out="this.state.account.quota.pages_limit"/>
                                        </span>
                                    </div>
                                    <div class="o_easyocr_quota_stat" t-if="this.state.account.quota.pages_remaining !== undefined">
                                        <span class="o_easyocr_quota_label">Left</span>
                                        <span class="o_easyocr_quota_value">
                                            <t t-out="this.state.account.quota.pages_remaining"/>
                                        </span>
                                    </div>
                                    <div class="o_easyocr_quota_stat" t-if="this.state.account.quota.reset_date">
                                        <span class="o_easyocr_quota_label">Resets</span>
                                        <span class="o_easyocr_quota_value" t-out="this.resetDateLabel()"/>
                                    </div>
                                    <div class="o_easyocr_quota_stat" t-if="this.state.account.wallet.exists and this.state.account.wallet.balance_pages">
                                        <span class="o_easyocr_quota_label">
                                            <i class="oi me-1" data-icon="credit_card"/>Wallet
                                        </span>
                                        <span class="o_easyocr_quota_value">
                                            <t t-out="this.state.account.wallet.balance_pages"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Not configured: point at the settings, nothing to do here. -->
                    <div class="o_easyocr_section o_easyocr_ai_hero" t-elif="this.state.account">
                        <div class="o_easyocr_ai_hero_head">
                            <div class="o_easyocr_ai_hero_icon o_easyocr_ai_icon_promo">
                                <i class="oi" data-icon="wand_stars"/>
                            </div>
                            <div>
                                <span class="o_easyocr_ai_hero_title">
                                    easyOCR AI
                                    <span class="o_easyocr_badge">PRO</span>
                                </span>
                                <p class="o_easyocr_ai_hero_hint">
                                    Configure the service to read scans and photographs.
                                    <a href="https://app.easyocr.es/register" target="_blank" rel="noopener">Create a free account</a>
                                </p>
                            </div>
                        </div>
                        <p class="o_easyocr_section_note">
                            Until the service is set in Settings, only PDFs that already carry their text can be read.
                        </p>
                    </div>
                    </div>

                    <div class="o_easyocr_sidebar_scroll">

                        <!-- Nothing to do to a document that is not there yet. -->
                        <div t-if="this.state.empty" class="o_easyocr_section">
                            <p class="o_easyocr_section_note">
                                No document yet. Open one, or drop it on the left, and the tools appear here.
                            </p>
                        </div>

                        <!-- The fields, one button per data. The number is the key
                             that arms it: 1-8 select the first eight, the way the
                             module this is a port of does it. -->
                        <div t-if="!this.state.empty" class="o_easyocr_section">
                            <h5>Labels <span class="o_easyocr_shortcut_hint">1-8</span></h5>
                            <p class="o_easyocr_section_note">
                                Select a label → Draw a rectangle on the PDF
                            </p>
                            <div class="o_easyocr_field_list">
                                <t t-foreach="this.fields" t-as="field" t-key="field.key">
                                    <button
                                        t-attf-class="o_easyocr_field {{ this.state.activeField === field.key ? 'active' : '' }}"
                                        t-attf-style="--eo-color: {{ field.color }}"
                                        t-on-click="() => this.setActiveField(field.key)"
                                        t-att-title="field.label"
                                    >
                                        <span class="o_easyocr_field_key"><t t-out="field_index + 1"/></span>
                                        <span class="o_easyocr_swatch"/>
                                        <t t-out="field.label"/>
                                    </button>
                                </t>
                            </div>
                        </div>

                        <!-- The template: pick one already saved and its boxes
                             come back, instead of drawing them again. Saving a
                             new one lives in the footer, next to the bill. -->
                        <div t-if="!this.state.empty" class="o_easyocr_section">
                            <h5>Templates</h5>
                            <p t-if="this.state.appliedTemplate and this.state.boxes.length" class="o_easyocr_applied">
                                <i class="oi me-1" data-icon="check_circle"/><t t-out="this.appliedLabel()"/>
                            </p>
                            <div class="o_easyocr_template_row">
                                <select
                                    class="o_easyocr_template_select form-select form-select-sm"
                                    t-model.proxy="this.state.templateId"
                                >
                                    <option value="">No template</option>
                                    <t t-foreach="this.state.templates" t-as="template" t-key="template.id">
                                        <option t-att-value="template.id"><t t-out="template.label"/></option>
                                    </t>
                                </select>
                                <button
                                    class="btn btn-primary btn-sm"
                                    t-on-click="this.applyTemplate"
                                    t-att-disabled="!this.state.templateId"
                                >
                                    Apply
                                </button>
                                <button
                                    t-if="this.state.appliedTemplate"
                                    class="btn btn-link btn-sm"
                                    t-on-click="this.clearBoxes"
                                    t-att-title="'Clear template'"
                                >&#215;</button>
                            </div>
                        </div>

                        <!-- Extra instructions that steer the service, folded
                             away until the reader wants them. -->
                        <div t-if="!this.state.empty and this.state.account and this.state.account.ai_enabled" class="o_easyocr_section">
                            <h5 class="o_easyocr_collapsible" t-on-click="this.toggleCustom">
                                AI Instructions
                                <i class="oi ms-auto" data-icon="expand_more"/>
                            </h5>
                            <textarea
                                t-if="this.state.customExpanded"
                                class="form-control form-control-sm"
                                rows="3"
                                t-model.proxy="this.state.customInstructions"
                                placeholder="Extra instructions"
                            />
                        </div>

                        <!-- What the boxes read, and the one action that turns a
                             drawn page into a filed document. -->
                        <div class="o_easyocr_section" t-if="this.state.boxes.length">
                            <h5>
                                Extracted data
                                <span class="o_easyocr_badge"><t t-out="this.state.boxes.length"/></span>
                            </h5>
                            <div class="o_easyocr_supplier mb-2">
                                <label class="o_easyocr_supplier_label">Supplier</label>
                                <select class="form-select form-select-sm" t-model.proxy="this.state.supplierId" t-on-change="this.setSupplier">
                                    <option value="">Select supplier</option>
                                    <t t-foreach="this.state.suppliers" t-as="supplier" t-key="supplier.id">
                                        <option t-att-value="supplier.id"><t t-out="supplier.name"/></option>
                                    </t>
                                </select>
                            </div>
                            <div class="o_easyocr_fields">
                                <div t-foreach="this.state.boxes" t-as="box" t-key="box.uid" class="o_easyocr_field_row">
                                    <span class="o_easyocr_field_label" t-out="this.labelFor(box.field_key)"/>
                                    <span class="o_easyocr_field_value" t-out="box.text"/>
                                    <button
                                        class="o_easyocr_remove"
                                        t-on-click="() => this.removeBox(box.uid)"
                                        t-att-title="this.removeLabel(box.field_key)"
                                    >&#215;</button>
                                </div>
                            </div>
                            <div class="o_easyocr_actions mt-2">
                                <button
                                    class="btn btn-secondary btn-sm w-100"
                                    type="button"
                                    t-on-click="() => this.fillDocument()"
                                ><t>Apply to invoice</t></button>
                            </div>

                            <!-- The completeness checklist: the five fields a
                                 bill cannot do without, and the four optional
                                 ones after. A field is done when a box has read
                                 text for it. -->
                            <div class="o_easyocr_readiness mt-2">
                                <t t-set="readiness" t-value="this.readinessItems()"/>
                                <div
                                    t-foreach="readiness.required"
                                    t-as="item"
                                    t-key="item.key"
                                    class="o_easyocr_readiness_row"
                                >
                                    <span t-att-class="item.done ? 'o_easyocr_chk o_easyocr_chk_done' : 'o_easyocr_chk'"><t t-out="item.done ? '●' : '○'"/></span>
                                    <t t-out="item.label"/>
                                </div>
                                <div
                                    t-foreach="readiness.optional"
                                    t-as="item"
                                    t-key="item.key"
                                    class="o_easyocr_readiness_row o_easyocr_readiness_optional"
                                >
                                    <span t-att-class="item.done ? 'o_easyocr_chk o_easyocr_chk_done' : 'o_easyocr_chk'"><t t-out="item.done ? '●' : '○'"/></span>
                                    <t t-out="item.label"/>
                                    <small class="o_easyocr_optional_badge">optional</small>
                                </div>
                                <div class="o_easyocr_readiness_summary"><t>Completeness</t>: <t t-out="readiness.done + '/' + readiness.total"/></div>
                            </div>
                        </div>

                    </div>

                    <!-- The two actions that finish the job, fixed at the bottom.
                         Generating the bill is the whole point of the screen, so
                         it is the primary one. -->
                    <div class="o_easyocr_actions_footer" t-if="!this.state.empty">
                        <button
                            class="btn btn-secondary"
                            t-on-click="this.saveTemplate"
                            t-att-disabled="this.state.saving"
                        >
                            Save template
                        </button>
                        <button
                            class="btn btn-primary"
                            t-on-click="this.createBill"
                            t-att-disabled="this.state.busy"
                        >
                            Generate Invoice
                        </button>
                    </div>

                    <!-- What the keyboard does. The number keys match the field
                         chips, which is how a whole page is drawn without the
                         mouse. One sentence, so it translates as one. -->
                    <div class="o_easyocr_help" t-if="!this.state.empty">
                        <i class="oi me-1" data-icon="keyboard"/>
                        Help and shortcuts
                        <i class="oi ms-1" data-icon="help" t-att-title="this.helpText()"/>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
