     The webhook is the fast path and this is the one that cannot be lost: a
     service that cannot reach this server, or an account with no webhook set,
     still ends up with its readings filed. It asks the service and takes what
     it finds, so running it too often costs nothing but a call.

     noupdate, because the interval is a decision of whoever runs the server. -->
<odoo>
    <data noupdate="1">

        <record id="ir_cron_easyocr_batch" model="ir.cron">
            <field name="name">EasyOCR: collect finished batches</field>
            <field name="model_id" ref="model_easyocr_batch"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <!-- Up to 17 a cron defaults to numbercall = 1: it runs once and
                 switches itself off, which leaves the batches to the webhook
                 alone from then on. A negative number is no limit. From 18 the
                 field is gone and the job runs while the module is installed. -->
            <field name="numbercall" eval="-1"/>
            <field name="active" eval="True"/>
        </record>

        <!-- The webhook log is not kept for ever: the calls older than the
             parameter easyocr.webhook_log_days (30 by default) are deleted. -->
        <record id="ir_cron_easyocr_webhook_log_purge" model="ir.cron">
            <field name="name">EasyOCR: forget old webhook calls</field>
            <field name="model_id" ref="model_easyocr_webhook_log"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- Up to 17 a cron runs once unless told otherwise. -->
            <field name="numbercall" eval="-1"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
