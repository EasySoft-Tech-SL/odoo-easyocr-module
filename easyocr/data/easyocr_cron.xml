     License LGPL-3 (see LICENSE file).

     The webhook is the fast path and this is the one that cannot be lost: a
     service that cannot reach this server, or an account with no webhook set,
     still ends up with its readings filed. It asks the service and takes what
     it finds, so running it too often costs nothing but a call.

     noupdate, because the interval is a decision of whoever runs the server. -->
<odoo>
    <data noupdate="1">

        <record id="ir_cron_easyocr_batch" model="ir.cron">
            <field name="name">EasyOCR: collect finished batches</field>
            <field name="model_id" ref="model_easyocr_batch"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
