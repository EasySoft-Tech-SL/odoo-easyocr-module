     The invoices the module generated, as a list of their own: the Dolibarr
     module this is a port of keeps a history of the bills made from imported
     PDFs, with the supplier reference and the origin, and this is that list on
     the Odoo bills. -->
<odoo>

    <record id="view_easyocr_invoice_list" model="ir.ui.view">
        <field name="name">easyocr.invoice.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Invoices" default_order="invoice_date desc">
                <field name="name" string="Ref."/>
                <field name="ref" string="Supplier Ref."/>
                <field name="invoice_date" string="Date"/>
                <field name="partner_id" string="Third party"/>
                <field name="amount_untaxed"/>
                <field name="amount_total"/>
            </list>
        </field>
    </record>

    <record id="action_easyocr_invoice" model="ir.actions.act_window">
        <field name="name">Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_easyocr_invoice_list"/>
        <field name="domain">[('move_type', '=', 'in_invoice')]</field>
    </record>

</odoo>
